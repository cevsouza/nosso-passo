# Prisma Database Connection
# For local development with SQLite, use "file:./dev.db"
# For production (e.g., PostgreSQL on Railway), use the database connection string
DATABASE_URL="file:./dev.db"

# Stripe Configurations (Get these from Stripe Dashboard -> Developers)
# 1. Stripe Secret Key (looks like sk_test_...)
STRIPE_SECRET_KEY=""

# 2. Stripe Price ID for the Subscription Product (looks like price_1P...)
STRIPE_PRICE_ID=""

# 3. Stripe Webhook Signing Secret (looks like whsec_...)
# In local development, get this from running: stripe listen --forward-to localhost:3000/api/webhook
# In production, get this when configuring the webhook endpoint in Stripe Dashboard
STRIPE_WEBHOOK_SECRET=""
