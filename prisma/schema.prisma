datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model UserProfile {
  uid             String   @id
  email           String   @unique
  passwordHash    String   @default("")
  role            String   @default("responsavel")
  childHyperfocus String?
  parentPinCode   String   @default("1234")
  lockType        String   @default("math")
  plan            String   @default("free")
  sensorySpeed    Float    @default(1.0)
  sensorySound    String   @default("marimba")
  sensoryVisuals  String   @default("rich")
  sensoryProfile  String   @default("balanced")
  timerStyle      String   @default("circle")
  createdAt       DateTime @default(now())
  tasks           Task[]
  children        Child[]
}

model Child {
  id              String      @id @default(cuid())
  name            String
  birthDate       String?     // YYYY-MM-DD
  gender          String?     // e.g. Masculino, Feminino, etc.
  diagnosis       String?     // e.g. TEA Nível 1, TDAH, etc.
  childHyperfocus String?     @default("Border Collies 🐕")
  parentPinCode   String      @default("1234")
  lockType        String      @default("math")
  sensorySpeed    Float       @default(1.0)
  sensorySound    String      @default("marimba")
  sensoryVisuals  String      @default("rich")
  sensoryProfile  String      @default("balanced")
  timerStyle      String      @default("circle")
  interfaceMode   String      @default("completo") // "foco" | "intermediario" | "completo"
  rewardName      String      @default("15 minutos de tablet")
  rewardCost      Int         @default(10)
  tokens          Int         @default(0)
  transitionMinutes Int       @default(5)
  createdAt       DateTime    @default(now())
  sharingCode     String?     @unique
  collectedParts  Int         @default(0)
  toyInventory    String      @default("")
  emotionalBattery String     @default("green")
  audioAlert10    String?
  audioAlert5     String?
  audioAlert2     String?
  monthlyTemplate String?
  emergencyFirstThen Boolean @default(false)
  behaviorDictionary String?
  unexpectedChange String?
  aacCustomItems  String?
  customStories   String?

  parentUid       String
  parent          UserProfile @relation(fields: [parentUid], references: [uid], onDelete: Cascade)
  tasks           Task[]
  sensoryLogs     SensoryLog[]
  checkpoints     Checkpoint[]
}

model Task {
  id          String   @id @default(cuid())
  title       String
  time        String
  period      String
  day         String
  isCompleted Boolean  @default(false)
  order       Int
  icon        String   @default("📅")
  customIcon  String?
  category    String   @default("AVD") // 'AVD' | 'Aprendizado' | 'Lazer'
  duration    Int      @default(30)
  description String   @default("")
  childId     String?
  child       Child?   @relation(fields: [childId], references: [id], onDelete: Cascade)
  userUid     String
  user        UserProfile @relation(fields: [userUid], references: [uid], onDelete: Cascade)
  month       Int?
  year        Int?
  createdAt   DateTime @default(now())
}

model Checkpoint {
  id               String   @id @default(cuid())
  weekNum          Int      // 1, 2, 3, 4
  status           String   @default("pending") // "pending" | "completed"
  notes            String   @default("")        // Relato dos pais
  feedback         String   @default("")        // Instrução do profissional
  professionalName String   @default("")
  professionalRole String   @default("")        // Especialidade
  date             String   @default("")        // Data da sessão (YYYY-MM-DD)
  childId          String
  child            Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
}

model SensoryLog {
  id             String      @id @default(cuid())
  timestamp      DateTime    @default(now())
  mood           String?     // 'feliz' | 'calmo' | 'agitado' | 'triste'
  crisisOccurred Boolean     @default(false)
  notes          String?
  decibels       Float?
  lightLevel     String?
  location       String?
  trigger        String?
  antecedent     String?
  behavior       String?
  consequence    String?
  loggedBy       String?     @default("parent")
  foodIntake     String?
  schoolNoise    String?
  latitude       Float?
  longitude      Float?
  childId        String
  child          Child       @relation(fields: [childId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id               String   @id @default(cuid())
  timestamp        DateTime @default(now())
  responsibleEmail String
  action           String
  details          String
}
